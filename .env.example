# ==============================================================================
# Unified Automator & Collaborative Workspace Configuration
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Jenkins Integration
JENKINS_URL=http://localhost:8080
JENKINS_USERNAME=your-jenkins-username
JENKINS_API_TOKEN=
GITHUB_JENKINS_CREDENTIAL_ID=

# GitHub push webhooks
# Use the same long random value in this setting and the GitHub repository webhook.
# PUBLIC_BASE_URL must be an HTTPS URL GitHub can reach; localhost will not work.
GITHUB_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# Docker Engine & Sandbox Configuration
# Leave DOCKER_HOST empty to use local named pipe (Windows) or socket (Unix)
DOCKER_HOST=
SANDBOX_IMAGE=python:3.10-slim
DEPLOY_PORT=5001

# Quality Gate Policy
# Set to true to strictly block deployments if mandatory code validation fails
ENFORCE_VALIDATION=true

# Task Execution Timeout in seconds
EXECUTION_TIMEOUT=60
