# Standalone Git-first Automator settings.
# Copy this file to .env in new-automator/ before starting the Automator.
# The AUTOMATOR_ prefix is required by config.py.

AUTOMATOR_HOST=0.0.0.0
AUTOMATOR_PORT=8001
AUTOMATOR_PUBLIC_BASE_URL=http://localhost:8001

# Local Jenkins example. Use a service name such as http://jenkins:8080 only
# when Jenkins and Automator are attached to the same configured Docker network.
AUTOMATOR_JENKINS_URL=http://localhost:8080
AUTOMATOR_JENKINS_USERNAME=
AUTOMATOR_JENKINS_API_TOKEN=

# Leave empty to use the local Docker socket or named pipe.
AUTOMATOR_DOCKER_HOST=

# Set a stable random value for webhook signature verification. Keep it out of
# source control and do not reuse a real token or password.
AUTOMATOR_GITHUB_WEBHOOK_SECRET=

# The second GitHub delivery uses the public Automator tunnel and is relayed
# locally to the Collaborative Workspace webhook endpoint.
AUTOMATOR_COLLABORATIVE_WORKSPACE_WEBHOOK_URL=http://127.0.0.1:8000/api/webhooks/github
